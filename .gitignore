# 构建产物
build/
build-*/
bin/*.exe
bin/*.dll
bin/*.o
bin/*.a
bin/stats.csv
bin/stress_mem.csv
bin/stress_rounds.txt
bin/stress_a.log
bin/stress_b_*.log
bin/stress_mem.csv
bin/stress_rounds.txt
bin/stress_a.log
bin/stress_b_*.log
logs/
devices.ini
# 现场配置含明文密码，只提交 config/sip.ini.example
sip.ini
bin/sip.ini
third_party/osip-install/

# 上游子模块（用 git submodule update --init 拉取，不入库）
/lvgl/
/FreeRTOS/
/lv_drivers/

# IDE / 系统文件
.vscode/
*.code-workspace.user
Thumbs.db
desktop.ini

# 自测产出的音频（音源可由 scripts/gen_test_wav.py 重新生成，落盘文件是调试残留）
bin/*.wav
bin/*.alaw
bin/*.raw

# 自测产出的视频（素材与参考帧由 scripts/duo_video_test.sh 用 ffmpeg 生成，
# 解码落盘的 .yuv 是调试残留，几百 MB，绝不入库）
bin/*.yuv
bin/*.h264

# 编译中间文件
*.obj
*.o
*.a
*.exe

# 双端测试/自测日志（每次跑都会重生成，只在排查时看）
bin/*.log

# 自测产出的抓屏（PPM/PNG 都是每次跑重新生成的，要留档的复制到 docs/img/）
bin/*.ppm
bin/*.png

# WorkBuddy 本地数据（工作记忆、自动化配置）
.workbuddy/

# 发布产物与发布构建目录（每次 make release 重新生成，不入库）
dist/
build-rel/

# 丢包验收的中间产物（每次跑重新生成）
bin/loss_*.log
bin/loss_*.yuv
bin/loss_*.crc
bin/loss_*.report

# python 编译缓存（kws_test.py 等脚本跑出来的）
__pycache__/
*.pyc

# python 编译缓存（kws_test.py 等脚本跑出来的）
__pycache__/
*.pyc
