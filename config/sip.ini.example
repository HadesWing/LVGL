# ---------------------------------------------------------------------------
# 室内机 SIP 配置（示例）
#
# 部署位置：/etc/indoor/sip.ini   ← 板子上（出厂烧写 / 现场改这一个文件）
#            bin/sip.ini          ← 开发机（当前工作目录）
# 优先级：    环境变量  >  本文件  >  编译默认值
#
# 注意：本文件含明文密码，不要提交进 git（.gitignore 已排除 sip.ini 本身，
#       只提交本示例）。批量交付时由生产工具按机器序列号生成。
# ---------------------------------------------------------------------------

[account]
server      = 192.168.1.10      ; SIP 服务器 / IPPBX 地址，域名或 IP
port        = 5060              ; 服务器端口，UDP
user        = 1001              ; 本机账号（Request-URI 与 From 里的 user）
password    = 1001              ; 认证密码；401 挑战时算 Digest
expires     = 3600              ; 注册有效期（秒），到期前自动续期

[media]
local_port  = 5062              ; 本机 SIP 监听端口，避开服务器的 5060
                                ; local_ip 留空 = 自动探测出口网卡；
                                ; 双网卡板子（eth0 + wlan0）必须写死
; local_ip  = 192.168.1.31

[behavior]
; 点对点模式：不注册、不需要服务器，用于「门口机 ↔ 室内机」直连调试
; 或出厂前无平台验证。置 1 后上面的 server 可以不填。
no_register = 0
